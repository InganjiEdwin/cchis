# Safe, non-secret production wiring used only by CI's resolved Compose check.
CCHIS_ENVIRONMENT=production
CCHIS_DJANGO_DEBUG=False
SECRET_KEY=ci-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

DB_NAME=cchis_db
DB_USER=postgres
DB_PASSWORD=ci-db-password
DB_HOST=db
DB_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/0

ALLOWED_HOSTS=app.cchis.test,backend,localhost
FRONTEND_APP_URL=https://app.cchis.test
CSRF_TRUSTED_ORIGINS=https://app.cchis.test
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.cchis.test
CORS_ALLOW_CREDENTIALS=True

AUTH_TOKEN_RESPONSE_MODE=cookie_only
AUTH_ACCESS_COOKIE_NAME=__Host-cchis_access
AUTH_REFRESH_COOKIE_NAME=__Host-cchis_refresh
AUTH_ACCESS_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_PATH=/
AUTH_ACCESS_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_ACCESS_COOKIE_HTTPONLY=True
AUTH_REFRESH_COOKIE_HTTPONLY=True
AUTH_ACCESS_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

SECURE_SSL_REDIRECT=True
SECURE_SSL_REDIRECT_REVERSE_PROXY_EXEMPTION=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_HOST=False
TRUST_X_FORWARDED_PROTO=False
TRUST_X_FORWARDED_FOR=False
TRUSTED_PROXY_CONFIGURED=False

EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=ci-mailgun-api-key
MAILGUN_DOMAIN=mg.cchis.test
MAILGUN_FROM_EMAIL=CI Alerts <alerts@mg.cchis.test>
MAILGUN_BASE_URL=https://api.mailgun.net/v3
MAILGUN_PASSKEY=ci-mailgun-passkey
MAILGUN_HOST=postmaster@mg.cchis.test
MAILGUN_REPLY_TO=
MAILGUN_WEBHOOK_SIGNING_KEY=ci-mailgun-webhook-key
MAILERSEND_WEBHOOK_SECRET=ci-mailersend-webhook-secret

SMS_PROVIDER=mobitech
AFRICAS_TALKING_ENABLED=false
MOBITECH_API_URL=https://mobitech.example.test/sms/sendmultiple
MOBITECH_API_KEY=ci-mobitech-api-key
MOBITECH_SENDER_ID=CCHIS-CI
MOBITECH_SERVICE_ID=0
MOBITECH_DELIVERY_CALLBACK_URL=https://app.cchis.test/api/v1/sms/mobitech/callback/ci-mobitech-callback-token/
MOBITECH_DELIVERY_CALLBACK_TOKEN=ci-mobitech-callback-token
MOBITECH_HTTP_TIMEOUT_SECONDS=20
MOBITECH_STATUS_API_URL=
MOBITECH_STATUS_AUTH_SCHEME=bearer
MOBITECH_STATUS_HTTP_TIMEOUT_SECONDS=20
AFRICASTALKING_USERNAME=ci-sms-user
AFRICASTALKING_API_KEY=ci-sms-api-key
AFRICASTALKING_SENDER_ID=CCHIS-CI
AFRICASTALKING_SMS_URL=https://api.africastalking.com/version1/messaging

NEXT_PUBLIC_API_BASE_URL=https://app.cchis.test/api/v1
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
NEXT_PUBLIC_CCHIS_ENVIRONMENT=production
NEXT_PUBLIC_FRONTEND_APP_URL=https://app.cchis.test
CCHIS_CSP_ENABLED=True
