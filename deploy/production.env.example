# Production deployment template. Every replace-* value is intentionally invalid
# until an operator supplies a reviewed value through a secret/config manager.
CCHIS_ENVIRONMENT=production
CCHIS_DJANGO_DEBUG=False
SECRET_KEY=replace-with-at-least-50-random-characters-from-a-secret-manager

DB_NAME=cchis_db
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=replace-with-private-database-host
DB_PORT=5432
CELERY_BROKER_URL=redis://replace-with-private-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://replace-with-private-redis-host:6379/1
CHANNEL_REDIS_URL=redis://replace-with-private-redis-host:6379/0

ALLOWED_HOSTS=app.example.org,backend
FRONTEND_APP_URL=https://app.example.org
CSRF_TRUSTED_ORIGINS=https://app.example.org
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.example.org
CORS_ALLOW_CREDENTIALS=True

AUTH_TOKEN_RESPONSE_MODE=cookie_only
AUTH_ACCESS_COOKIE_NAME=__Host-cchis_access
AUTH_REFRESH_COOKIE_NAME=__Host-cchis_refresh
AUTH_ACCESS_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_PATH=/
AUTH_ACCESS_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_ACCESS_COOKIE_HTTPONLY=True
AUTH_REFRESH_COOKIE_HTTPONLY=True
AUTH_ACCESS_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

SECURE_SSL_REDIRECT=True
SECURE_SSL_REDIRECT_REVERSE_PROXY_EXEMPTION=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_HOST=False
TRUST_X_FORWARDED_PROTO=False
TRUST_X_FORWARDED_FOR=False
TRUSTED_PROXY_CONFIGURED=False

# Select real providers and supply their credentials through the secret manager.
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=replace-with-mailgun-api-key
MAILGUN_PASSKEY=replace-with-mailgun-passkey
MAILGUN_HOST=postmaster@replace-with-mailgun-domain
MAILGUN_DOMAIN=replace-with-mailgun-domain
MAILGUN_FROM_EMAIL=replace-with-verified-sender
MAILGUN_BASE_URL=https://api.mailgun.net/v3
MAILGUN_REPLY_TO=
MAILGUN_WEBHOOK_SIGNING_KEY=replace-with-mailgun-webhook-signing-key
MAILERSEND_WEBHOOK_SECRET=replace-with-mailersend-webhook-secret
SMS_PROVIDER=mobitech
AFRICAS_TALKING_ENABLED=false
MOBITECH_API_URL=https://app.mobitechtechnologies.com//sms/sendmultiple
MOBITECH_API_KEY=replace-with-mobitech-api-key
MOBITECH_SENDER_ID=replace-with-approved-sender-id
MOBITECH_SERVICE_ID=0
MOBITECH_DELIVERY_CALLBACK_URL=https://app.example.org/api/v1/sms/mobitech/callback/replace-with-callback-route-token/
MOBITECH_DELIVERY_CALLBACK_TOKEN=replace-with-callback-route-token
MOBITECH_HTTP_TIMEOUT_SECONDS=20
MOBITECH_STATUS_API_URL=
MOBITECH_STATUS_AUTH_SCHEME=bearer
MOBITECH_STATUS_HTTP_TIMEOUT_SECONDS=20
AFRICASTALKING_USERNAME=replace-with-sms-username
AFRICASTALKING_API_KEY=replace-with-sms-api-key
AFRICASTALKING_SENDER_ID=replace-with-approved-sender-id
AFRICASTALKING_SMS_URL=https://api.africastalking.com/version1/messaging

# Browser-facing and server-to-server URLs are intentionally separate.
# NEXT_PUBLIC_API_BASE_URL is a frontend image build-time value. Rebuild the
# frontend image whenever this browser-facing API/WS origin changes; changing
# only the running container environment cannot rewrite an already compiled
# Next.js bundle.
NEXT_PUBLIC_API_BASE_URL=https://app.example.org/api/v1
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
NEXT_PUBLIC_CCHIS_ENVIRONMENT=production
CCHIS_CSP_ENABLED=True
